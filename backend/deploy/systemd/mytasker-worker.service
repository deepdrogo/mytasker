[Unit]
Description=MyTasker Celery worker (default + notify queues)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=mytasker
Group=mytasker
WorkingDirectory=/home/mytasker/htdocs/mytasker.io/backend
EnvironmentFile=/home/mytasker/htdocs/mytasker.io/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/mytasker/htdocs/mytasker.io/backend/.venv/bin/celery -A config worker \
  --queues default,notify \
  --concurrency 4 \
  --max-tasks-per-child 500 \
  --loglevel INFO \
  --without-gossip --without-mingle
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/mytasker/htdocs/mytasker.io/backend /home/mytasker/logs/mytasker
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
