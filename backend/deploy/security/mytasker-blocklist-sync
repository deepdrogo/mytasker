#!/usr/bin/env bash
#
# Turn the app's blocklist (plain addresses written by the unprivileged app user) into nginx `deny` rules.
#
# The app user never writes nginx config itself: every line is re-parsed here as an IP address or network, so a
# compromised app can at worst ban addresses - it cannot inject directives. Trusted addresses are never denied.
# nginx is only reloaded after `nginx -t` passes; on failure the previous file is restored.
#
# Installed as /usr/local/sbin/mytasker-blocklist-sync, run by mytasker-blocklist.path (on change) and
# mytasker-blocklist.timer (every minute, as a safety net).
set -euo pipefail

SRC=/home/mytasker/htdocs/mytasker.io/backend/var/blocklist.txt
DST=/etc/nginx/snippets/mytasker-blocklist.conf
ENV=/home/mytasker/htdocs/mytasker.io/backend/.env

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

TRUSTED=$(grep -E '^SECURITY_TRUSTED_IPS=' "$ENV" 2>/dev/null | cut -d= -f2- || true)

python3 - "$SRC" "$TRUSTED" > "$tmp" <<'PY'
import ipaddress, sys
src, trusted_raw = sys.argv[1], sys.argv[2]
trusted = []
for item in trusted_raw.split(","):
    try:
        trusted.append(ipaddress.ip_network(item.strip(), strict=False))
    except ValueError:
        pass
seen = set()
print("# Generated by mytasker-blocklist-sync - do not edit. Source: the app blocklist.")
try:
    lines = open(src, encoding="ascii", errors="strict").read().splitlines()[:50000]
except (OSError, UnicodeDecodeError):
    lines = []
for raw in lines:
    try:
        net = ipaddress.ip_network(raw.strip(), strict=False)
    except ValueError:
        continue
    if net.prefixlen < (16 if net.version == 4 else 32):
        continue
    if any(net.overlaps(t) for t in trusted):
        continue
    text = str(net.network_address) if net.num_addresses == 1 else str(net)
    if text not in seen:
        seen.add(text)
        print(f"deny {text};")
PY

if [[ -f $DST ]] && cmp -s "$tmp" "$DST"; then
  exit 0
fi

backup=""
if [[ -f $DST ]]; then
  backup=$(mktemp)
  cp -p "$DST" "$backup"
fi
install -m 0644 -o root -g root "$tmp" "$DST"
if nginx -t -q 2>/dev/null; then
  systemctl reload nginx
  logger -t mytasker-blocklist "nginx blocklist updated: $(grep -c '^deny' "$DST") entries"
else
  if [[ -n $backup ]]; then cp -p "$backup" "$DST"; else : > "$DST"; fi
  logger -t mytasker-blocklist "nginx -t failed - previous blocklist restored"
  exit 1
fi
[[ -n $backup ]] && rm -f "$backup"
exit 0
