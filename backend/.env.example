# Copy to backend/.env and fill in. Never commit the real file.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173

DATABASE_URL=postgres://mytasker:mytasker@127.0.0.1:5432/mytasker
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_DB=1
REDIS_BROKER_DB=2
REDIS_CHANNELS_DB=3

# AI assistant (admin-only). Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Telegram bot (webhook mode). Leave the token empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me-random

# Email (console backend for local dev)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL="MyTasker <no-reply@localhost>"
REQUIRE_EMAIL_VERIFICATION=false

SENTRY_DSN=
